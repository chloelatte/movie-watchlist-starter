              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/watchlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "watchlist"
              ]
            },
            "description": "Add an existing movie to the authenticated user's watchlist. Set `movieId` in the request body to an existing movie ID. Requires a valid JWT access token."
          },
          "response": []
        },
        {
          "name": "Remove Movie from Watchlist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/watchlist/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "watchlist",
                "{{movieId}}"
              ]
            },
            "description": "Remove the specified movie from the authenticated user's watchlist. Set the `movieId` collection variable to the target movie ID. Requires a valid JWT access token."
          },
          "response": []
        }
      ],
      "description": "Authenticated endpoints for viewing, adding, and removing movies in the current user's watchlist."
    },
